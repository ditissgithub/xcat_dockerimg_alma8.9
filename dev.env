####### This dev.env file has environment variable for xCAT Configuration ################

###################################MySQL Database Setup##############################
#====================================================================================
#To switch xcat from SQLite database to MySQL database. 
#====================================================================================
# Set MySQL port except default (3306), as 3306 is used by the Docker host machine
MYSQL_PORT=3307

# Set the MySQL admin password for xCAT, ensuring the password is alphanumeric (don't use special character.)
MYSQLADMIN_PW=Rudra123

# Set the MySQL root password for xCAT, ensuring the password is alphanumeric (don't use special character.)
MYSQLROOT_PW=Rudra123

####################################Site Table#######################################
#====================================================================================
#Set time zone for Time Synchronization for ensuring consistent time configuration across all nodes in your HPC/AI cluster
#====================================================================================
#Set time zone according to your env
TIMEZONE=Asia/Kolkata


#====================================================================================
#The network interfaces DHCP should listen on. If it is the same for all nodes, use a simple comma-separated list of NICs.
#====================================================================================
#Your dhcp-interface name (NIC name where DHCP Listening)
DHCPINTERFACE=eth2,eth2:0

#(OR) with adding xcat management hostname and node group all
#DHCPINTERFACE=hpc-master01 | eth2,eth2:0;all

#====================================================================================
#The network interfaces DHCP should listen on. To specify different NICs for different nodes (or) On all of the nodes in group (like pod-service) 
#====================================================================================
#In service group, which have a node range, 
#xcatmn|eth1,eth2;service|bond0.


#====================================================================================
#
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================
#====================================================================================


             
      
        
       
DOMAIN=iitp.ac.in               ##Your domain
MASTER=172.25.0.3            ##Your vip
NAMESERVERS=172.25.0.1       ##Same as MASTER
FORWARDERS=172.25.0.1        ##Same as MASTER
IB_Net=172.26.0.0              ##Network of ib network
IB_Mask=255.255.254.0          ##Genmask of ib network
ObjectName=172_25_0_0-255_255_254_0   ##NetworkofVIP-GenmaskofVIP;check with <route -n> on system
Dhcpserver=172.25.0.1              ##Same as MASTER
Gateway=172.25.0.1                   ##Gateway of system machine
IP_Mask=255.255.254.0                 ##Genmask of vip
Mgtifname=eth2:0                      ##NIC name vip
IP_Net=172.25.0.0                     ##Network of vip
Tftpserver=172.25.0.1               ##Same as Master
Xcatmaster="<xcatmaster>"             ##Don't Change
xcat_VIP=172.25.0.3                    ##xcat vip address

