################################### xCAT Environment Configuration ###################################

# xCAT Virtual IP Address (used when xCAT is configured in HA mode via PCS with a floating VIP)
xcat_VIP=172.25.0.3


############################### MySQL Database Configuration #########################################

# MySQL port for xCAT (avoid default 3306 if it's in use on the Docker host)
MYSQL_PORT=3307

# MySQL admin password for xCAT (use only alphanumeric characters) (don't use special character.)
MYSQLADMIN_PW=Rudra123

# MySQL root password for xCAT (use only alphanumeric characters) (don't use special character.)
MYSQLROOT_PW=Rudra123


#################################### Site Table Configuration ########################################

# Set the system timezone for all cluster nodes
TIMEZONE=Asia/Kolkata

# DHCP interface name(s) for xCAT (use comma-separated list if needed)
DHCPINTERFACE=eth2,eth2:0

# DNS domain name for the cluster
DOMAIN=iitp.ac.in

# DNS forwarders for external name resolution (use xCAT VIP or individual hosts)
FORWARDERS=172.25.0.3
# Alternative: FORWARDERS=172.25.0.1,172.25.0.2

# xCAT master IP (use VIP if HA is configured)
MASTER=172.25.0.3

# Nameserver setting for nodes (can use <xcatmaster> or static IP)
NAMESERVERS=<xcatmaster>
# Alternative: NAMESERVERS=172.25.0.3


#################################### Infiniband Network Configuration #################################

# IB base network and subnet
IB_Net=172.26.0.0
IB_Mask=255.255.254.0

# xCAT master for gateway/DNS forwarding (optional override)
Xcatmaster=<xcatmaster>


############################### Network Entry Configuration ###########################################

# Object name format: network-mask (e.g., 172_25_0_0-255_255_254_0)
ObjectName=172_25_0_0-255_255_254_0

# DHCP server IP (typically xCAT VIP or management node IP)
Dhcpserver=172.25.0.3

# Gateway for compute nodes to reach xCAT management
Gateway=172.25.0.3

# Subnet mask and base network for xCAT Management
IP_Mask=255.255.254.0
IP_Net=172.25.0.0

# Management interface used by nodes (e.g., eth2 or eth2:0)
Mgtifname=eth2:0

# TFTP server for PXE boot (usually same as DHCP server)
Tftpserver=172.25.0.3

#######################################################################################################



             
      
        
       


